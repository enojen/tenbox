{
  "formatter": { "indentStyle": "space", "indentWidth": 2, "lineWidth": 100 },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true,
      "style": {
        "noMagicNumbers": "error",
        "noNonNullAssertion": "error",
        "noParameterAssign": "error",
        "noNestedTernary": "error",
        "noDefaultExport": "error"
      },
      "suspicious": { "noExplicitAny": "error", "useAwait": "error" },
      "complexity": { "noForEach": "error", "noExcessiveCognitiveComplexity": "error" },
      "correctness": {
        "noUnusedImports": "error",
        "noUnusedVariables": "error",
        "noUnusedFunctionParameters": "error"
      }
    }
  },
  "plugins": [
    "./rules/await-at-statement-start/rule.grit",
    "./rules/named-parameter-types/rule.grit",
    "./rules/no-destructured-parameters/rule.grit",
    "./rules/no-json-roundtrip/rule.grit",
    "./rules/named-union-members/rule.grit",
    "./rules/datetime-fields/rule.grit"
  ],
  "overrides": [
    {
      "includes": ["**/*.test.ts"],
      "linter": {
        "rules": { "style": { "noMagicNumbers": "off" }, "suspicious": { "useAwait": "off" } }
      },
      "plugins": [
        "./rules/no-conditional-expect/rule.grit",
        "./rules/no-caught-error-in-tests/rule.grit"
      ]
    },
    {
      "includes": ["**", "!**/domain/ids.ts", "!**/domain/failures.ts"],
      "plugins": ["./rules/no-inline-cast/rule.grit"]
    },
    {
      "includes": ["**", "!**/domain/errors/**"],
      "plugins": ["./rules/errors-from-domain/rule.grit"]
    },
    {
      "includes": ["**/cli/application/**", "!**/*.test.ts"],
      "plugins": ["./rules/no-raw-git-in-application/rule.grit"]
    },
    {
      "includes": ["**", "!**/*.test.ts", "!**/cli/infra/processes.ts", "!**/cli/test/cli.ts"],
      "plugins": ["./rules/no-raw-spawn/rule.grit"]
    },
    {
      "includes": ["**", "!**/*.test.ts", "!**/domain/utils.ts", "!**/rules/*/good.ts"],
      "plugins": ["./rules/no-raw-json-parse/rule.grit"]
    },
    {
      "includes": [
        "**",
        "!**/*.test.ts",
        "!**/domain/**",
        "!**/cli/infra/**",
        "!**/cli/test/**",
        "!**/rules/*/good.ts"
      ],
      "plugins": ["./rules/json-readers-in-domain/rule.grit"]
    },
    {
      "includes": ["**", "!**/*.test.ts", "!**/cli/infra/files.ts", "!**/cli/main.ts"],
      "plugins": ["./rules/write-json-once/rule.grit"]
    },
    {
      "includes": ["**", "!**/*.test.ts"],
      "plugins": ["./rules/no-state-literal-compare/rule.grit"]
    }
  ],
  "assist": { "enabled": true, "actions": { "source": { "organizeImports": "on" } } },
  "files": { "includes": ["cli/**", "domain/**", "server/**", "rules/**", "!rules/*/bad.ts"] }
}

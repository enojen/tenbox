{
  "components": {
    "responses": {
      "NotMember": {
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/Problem"
            }
          }
        },
        "description": "The user is not a member of the project's organization"
      },
      "TooManyRequests": {
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/Problem"
            }
          }
        },
        "description": "Over a limit of the user: requests per second (code too-many-requests), or followed logs open at one time (code too-many-log-streams); ask again after Retry-After seconds",
        "headers": {
          "Retry-After": {
            "description": "Seconds to wait before asking again",
            "schema": {
              "minimum": 1,
              "type": "integer"
            }
          }
        }
      },
      "Unauthorized": {
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/Problem"
            }
          }
        },
        "description": "No token, or a token Tenport does not know"
      },
      "Unavailable": {
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/Problem"
            }
          }
        },
        "description": "The request did not end in time (code timeout), or the database does not answer (code database-down)"
      }
    },
    "schemas": {
      "Author": {
        "properties": {
          "email": {
            "example": "1+enojen@users.noreply.github.com",
            "type": "string"
          },
          "name": {
            "type": "string"
          }
        },
        "required": [
          "name",
          "email"
        ],
        "type": "object"
      },
      "DeletedTask": {
        "properties": {
          "archive": {
            "$ref": "#/components/schemas/TaskArchiveState"
          },
          "project": {
            "type": "string"
          },
          "task": {
            "example": "TEN-301",
            "type": "string"
          }
        },
        "required": [
          "project",
          "task",
          "archive"
        ],
        "type": "object"
      },
      "Health": {
        "properties": {
          "ok": {
            "type": "boolean"
          }
        },
        "required": [
          "ok"
        ],
        "type": "object"
      },
      "Me": {
        "properties": {
          "email": {
            "type": [
              "string",
              "null"
            ]
          },
          "github": {
            "type": "string"
          },
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "organizations": {
            "items": {
              "$ref": "#/components/schemas/MyOrganization"
            },
            "type": "array"
          }
        },
        "required": [
          "id",
          "name",
          "github",
          "organizations"
        ],
        "type": "object"
      },
      "MyOrganization": {
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "role": {
            "$ref": "#/components/schemas/Role"
          }
        },
        "required": [
          "id",
          "name",
          "role"
        ],
        "type": "object"
      },
      "NewProject": {
        "properties": {
          "name": {
            "type": "string"
          },
          "organization": {
            "type": "string"
          },
          "repo": {
            "example": "enojen/tenport",
            "type": "string"
          }
        },
        "required": [
          "organization",
          "name",
          "repo"
        ],
        "type": "object"
      },
      "NewRun": {
        "properties": {
          "author": {
            "$ref": "#/components/schemas/Author"
          },
          "base": {
            "example": "main",
            "type": "string"
          },
          "class": {
            "example": "build",
            "type": "string"
          },
          "command": {
            "example": [
              "tenbox",
              "build",
              "TEN-301"
            ],
            "items": {
              "type": "string"
            },
            "type": "array",
            "x-tenbox-commands": {
              "answer": {
                "before_task": [],
                "bool_flags": [],
                "positionals": 1,
                "value_flags": []
              },
              "approve": {
                "before_task": [],
                "bool_flags": [],
                "positionals": 0,
                "value_flags": []
              },
              "build": {
                "before_task": [],
                "bool_flags": [],
                "positionals": 0,
                "value_flags": []
              },
              "check": {
                "before_task": [],
                "bool_flags": [],
                "positionals": 0,
                "value_flags": [
                  "--group",
                  "--tier"
                ]
              },
              "close": {
                "before_task": [],
                "bool_flags": [
                  "--force"
                ],
                "positionals": 0,
                "value_flags": []
              },
              "decide": {
                "before_task": [],
                "bool_flags": [
                  "--no-build"
                ],
                "positionals": 0,
                "value_flags": [
                  "--json"
                ]
              },
              "plan": {
                "before_task": [
                  "show"
                ],
                "bool_flags": [],
                "positionals": 0,
                "value_flags": []
              },
              "pr": {
                "before_task": [],
                "bool_flags": [
                  "--ready",
                  "--force",
                  "--wait"
                ],
                "positionals": 0,
                "value_flags": []
              },
              "start": {
                "before_task": [],
                "bool_flags": [
                  "--force"
                ],
                "positionals": 0,
                "value_flags": [
                  "--title"
                ]
              },
              "status": {
                "before_task": [],
                "bool_flags": [],
                "positionals": 0,
                "value_flags": []
              }
            }
          },
          "env": {
            "additionalProperties": {
              "type": "string"
            },
            "propertyNames": {
              "type": "string"
            },
            "type": "object"
          },
          "project": {
            "type": "string"
          },
          "services": {
            "example": [
              "postgres"
            ],
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "setup": {
            "type": "string"
          },
          "task": {
            "example": "TEN-301",
            "type": "string"
          }
        },
        "required": [
          "project",
          "task",
          "command",
          "base",
          "class",
          "author"
        ],
        "type": "object"
      },
      "NewSecretValue": {
        "properties": {
          "value": {
            "maxLength": 4096,
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "value"
        ],
        "type": "object"
      },
      "Problem": {
        "properties": {
          "code": {
            "type": "string"
          },
          "detail": {
            "type": "string"
          },
          "status": {
            "format": "int32",
            "minimum": 0,
            "type": "integer"
          },
          "title": {
            "type": "string"
          },
          "type": {
            "type": "string"
          }
        },
        "required": [
          "type",
          "title",
          "status",
          "detail",
          "code"
        ],
        "type": "object"
      },
      "Project": {
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "organization": {
            "type": "string"
          },
          "repo": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "organization",
          "name",
          "repo"
        ],
        "type": "object"
      },
      "ProjectSecret": {
        "enum": [
          "tracker_api_key",
          "ntfy_url"
        ],
        "type": "string"
      },
      "Recorded": {
        "properties": {
          "skipped": {
            "minimum": 0,
            "type": "integer"
          },
          "stored": {
            "minimum": 0,
            "type": "integer"
          }
        },
        "required": [
          "stored",
          "skipped"
        ],
        "type": "object"
      },
      "ReportedEvent": {
        "allOf": [
          {
            "$ref": "#/components/schemas/TasksEvent"
          },
          {
            "properties": {
              "at": {
                "format": "date-time",
                "type": "string"
              },
              "id": {
                "example": "019a8f2e-7c4b-7d21-9a3e-5b8c1d2e3f40",
                "type": "string"
              }
            },
            "required": [
              "id",
              "at"
            ],
            "type": "object"
          }
        ]
      },
      "Role": {
        "enum": [
          "admin",
          "member"
        ],
        "type": "string"
      },
      "Run": {
        "properties": {
          "name": {
            "example": "task-ten-301-1117-101500",
            "type": "string"
          },
          "project": {
            "type": "string"
          },
          "task": {
            "example": "TEN-301",
            "type": "string"
          }
        },
        "required": [
          "name",
          "project",
          "task"
        ],
        "type": "object"
      },
      "RunCredential": {
        "properties": {
          "value": {
            "type": "string"
          }
        },
        "required": [
          "value"
        ],
        "type": "object"
      },
      "RunCredentialRequest": {
        "properties": {
          "host": {
            "example": "api.github.com",
            "type": "string"
          },
          "placeholder": {
            "example": "tbxph_ETORSF6tK5Aq-PPCa0hncaILEOC-43LTqxG9R15MW38",
            "type": "string"
          }
        },
        "required": [
          "placeholder",
          "host"
        ],
        "type": "object"
      },
      "RunPhase": {
        "enum": [
          "Running",
          "Succeeded",
          "Failed",
          "Unknown"
        ],
        "type": "string"
      },
      "RunState": {
        "properties": {
          "class": {
            "example": "build",
            "type": "string"
          },
          "command": {
            "example": "build",
            "type": "string"
          },
          "created": {
            "format": "date-time",
            "type": "string"
          },
          "exit_code": {
            "example": 0,
            "format": "int32",
            "type": [
              "integer",
              "null"
            ]
          },
          "name": {
            "example": "task-ten-301-1117-101500",
            "type": "string"
          },
          "oom_kill": {
            "example": 0,
            "format": "int64",
            "minimum": 0,
            "type": [
              "integer",
              "null"
            ]
          },
          "output": {
            "type": [
              "object",
              "null"
            ]
          },
          "phase": {
            "$ref": "#/components/schemas/RunPhase"
          },
          "project": {
            "type": "string"
          },
          "reason": {
            "example": "OOMKilled",
            "type": [
              "string",
              "null"
            ]
          },
          "task": {
            "example": "TEN-301",
            "type": "string"
          }
        },
        "required": [
          "name",
          "project",
          "task",
          "command",
          "class",
          "created",
          "phase"
        ],
        "type": "object"
      },
      "Secret": {
        "properties": {
          "changed": {
            "format": "date-time",
            "type": "string"
          },
          "name": {
            "$ref": "#/components/schemas/ProjectSecret"
          }
        },
        "required": [
          "name",
          "changed"
        ],
        "type": "object"
      },
      "TaskArchiveState": {
        "enum": [
          "deleted",
          "missing"
        ],
        "type": "string"
      },
      "TaskClosed": {
        "properties": {
          "project": {
            "type": "string"
          },
          "task": {
            "example": "TEN-301",
            "type": "string"
          }
        },
        "required": [
          "project",
          "task"
        ],
        "type": "object"
      },
      "TaskDeleted": {
        "properties": {
          "project": {
            "type": "string"
          },
          "task": {
            "example": "TEN-301",
            "type": "string"
          }
        },
        "required": [
          "project",
          "task"
        ],
        "type": "object"
      },
      "TaskStarted": {
        "properties": {
          "project": {
            "type": "string"
          },
          "task": {
            "example": "TEN-301",
            "type": "string"
          },
          "title": {
            "type": [
              "string",
              "null"
            ]
          },
          "url": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "project",
          "task"
        ],
        "type": "object"
      },
      "TasksEvent": {
        "oneOf": [
          {
            "allOf": [
              {
                "$ref": "#/components/schemas/TaskStarted"
              },
              {
                "properties": {
                  "type": {
                    "enum": [
                      "task.started"
                    ],
                    "type": "string"
                  }
                },
                "required": [
                  "type"
                ],
                "type": "object"
              }
            ]
          },
          {
            "allOf": [
              {
                "$ref": "#/components/schemas/TaskClosed"
              },
              {
                "properties": {
                  "type": {
                    "enum": [
                      "task.closed"
                    ],
                    "type": "string"
                  }
                },
                "required": [
                  "type"
                ],
                "type": "object"
              }
            ]
          },
          {
            "allOf": [
              {
                "$ref": "#/components/schemas/TaskDeleted"
              },
              {
                "properties": {
                  "type": {
                    "enum": [
                      "task.deleted"
                    ],
                    "type": "string"
                  }
                },
                "required": [
                  "type"
                ],
                "type": "object"
              }
            ]
          }
        ]
      }
    },
    "securitySchemes": {
      "bearer": {
        "scheme": "bearer",
        "type": "http"
      },
      "injector": {
        "description": "The injector token: only the injector of the egress proxy has it",
        "scheme": "bearer",
        "type": "http"
      }
    }
  },
  "info": {
    "description": "The backend of Tenyard. Limits: 10 requests per second for each user, 20 at once (429, code too-many-requests); 5 followed logs open for each user (429, code too-many-log-streams); 30 seconds for a request to answer (503, code timeout); 2 MB for a body (413). A 429 has Retry-After: ask again after that many seconds. A list gives 50 items, up to 100 with limit, and a Link header with rel=\"next\" for the next page.",
    "license": {
      "name": "FSL-1.1-ALv2"
    },
    "title": "Tenport",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/events": {
      "post": {
        "operationId": "record_events",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "items": {
                  "$ref": "#/components/schemas/ReportedEvent"
                },
                "type": "array"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Recorded"
                }
              }
            },
            "description": "The new events are stored; an id Tenport has is skipped"
          },
          "400": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "The body is not a list of valid events"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/NotMember"
          },
          "409": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "An id came before with other content, or an event does not fit the state; nothing is stored"
          },
          "429": {
            "$ref": "#/components/responses/TooManyRequests"
          },
          "503": {
            "$ref": "#/components/responses/Unavailable"
          }
        },
        "security": [
          {
            "bearer": []
          }
        ]
      }
    },
    "/health": {
      "get": {
        "operationId": "health",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            },
            "description": "The database answers"
          },
          "503": {
            "$ref": "#/components/responses/Unavailable"
          }
        }
      }
    },
    "/me": {
      "get": {
        "operationId": "me",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Me"
                }
              }
            },
            "description": "The user of the token and their organizations"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "429": {
            "$ref": "#/components/responses/TooManyRequests"
          },
          "503": {
            "$ref": "#/components/responses/Unavailable"
          }
        },
        "security": [
          {
            "bearer": []
          }
        ]
      }
    },
    "/projects": {
      "get": {
        "operationId": "list_projects",
        "parameters": [
          {
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "default": 50,
              "format": "int32",
              "maximum": 100,
              "minimum": 1,
              "type": "integer"
            }
          },
          {
            "in": "query",
            "name": "after",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/Project"
                  },
                  "type": "array"
                }
              }
            },
            "description": "The projects of the user's organizations, by name; a Link header with rel=\"next\" gives the next page",
            "headers": {
              "Link": {
                "description": "The next page, when there is one",
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "400": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "A limit out of 1 to 100, or an after that is not a project id"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "429": {
            "$ref": "#/components/responses/TooManyRequests"
          },
          "503": {
            "$ref": "#/components/responses/Unavailable"
          }
        },
        "security": [
          {
            "bearer": []
          }
        ]
      },
      "post": {
        "operationId": "add_project",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/NewProject"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Project"
                }
              }
            },
            "description": "The project is added"
          },
          "400": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "The body is not a valid new project"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "The user is not an admin of the organization"
          },
          "429": {
            "$ref": "#/components/responses/TooManyRequests"
          },
          "503": {
            "$ref": "#/components/responses/Unavailable"
          }
        },
        "security": [
          {
            "bearer": []
          }
        ]
      }
    },
    "/projects/{project}/secrets": {
      "get": {
        "operationId": "list_secrets",
        "parameters": [
          {
            "description": "The id of the project",
            "in": "path",
            "name": "project",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/Secret"
                  },
                  "type": "array"
                }
              }
            },
            "description": "The secrets that Tenport wrote for the project, by name: never their values"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/NotMember"
          },
          "429": {
            "$ref": "#/components/responses/TooManyRequests"
          },
          "503": {
            "$ref": "#/components/responses/Unavailable"
          }
        },
        "security": [
          {
            "bearer": []
          }
        ]
      }
    },
    "/projects/{project}/secrets/{name}": {
      "delete": {
        "operationId": "delete_secret",
        "parameters": [
          {
            "description": "The id of the project",
            "in": "path",
            "name": "project",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "description": "The name of the secret",
            "in": "path",
            "name": "name",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/ProjectSecret"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "The secret is deleted from the Secret project-<project id>"
          },
          "400": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "A name Tenport does not know"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "The user is not an admin of the project's organization"
          },
          "404": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "The project has no such secret"
          },
          "429": {
            "$ref": "#/components/responses/TooManyRequests"
          },
          "503": {
            "$ref": "#/components/responses/Unavailable"
          }
        },
        "security": [
          {
            "bearer": []
          }
        ]
      },
      "put": {
        "operationId": "write_secret",
        "parameters": [
          {
            "description": "The id of the project",
            "in": "path",
            "name": "project",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "description": "The name of the secret",
            "in": "path",
            "name": "name",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/ProjectSecret"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/NewSecretValue"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Secret"
                }
              }
            },
            "description": "The secret is written to the Secret project-<project id>; Tenport keeps no copy and gives back only its name"
          },
          "400": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "A name Tenport does not know, or a value that is empty or too long"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "The user is not an admin of the project's organization"
          },
          "429": {
            "$ref": "#/components/responses/TooManyRequests"
          },
          "503": {
            "$ref": "#/components/responses/Unavailable"
          }
        },
        "security": [
          {
            "bearer": []
          }
        ]
      }
    },
    "/run-credentials": {
      "post": {
        "operationId": "run_credential",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RunCredentialRequest"
              }
            }
          },
          "description": "A placeholder that a box sent, and the host it sent it to",
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RunCredential"
                }
              }
            },
            "description": "The one-hour GitHub App token for the repository of the open Job that has this placeholder"
          },
          "400": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "The body is not a placeholder and a host"
          },
          "401": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "No injector token, or another one"
          },
          "404": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "No open Job of Tenport has this placeholder, the host is not GitHub, or the GitHub App is not installed on the repository"
          },
          "429": {
            "$ref": "#/components/responses/TooManyRequests"
          },
          "503": {
            "$ref": "#/components/responses/Unavailable"
          }
        },
        "security": [
          {
            "injector": []
          }
        ]
      }
    },
    "/runs": {
      "get": {
        "operationId": "list_runs",
        "parameters": [
          {
            "in": "query",
            "name": "project",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "example": "TEN-301",
            "in": "query",
            "name": "task",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "default": 50,
              "format": "int32",
              "maximum": 100,
              "minimum": 1,
              "type": "integer"
            }
          },
          {
            "in": "query",
            "name": "after",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/RunState"
                  },
                  "type": "array"
                }
              }
            },
            "description": "The runs of the task, the oldest first; a Link header with rel=\"next\" gives the next page",
            "headers": {
              "Link": {
                "description": "The next page, when there is one",
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "400": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "No project or task, an id that is not valid, or a limit out of 1 to 100"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/NotMember"
          },
          "429": {
            "$ref": "#/components/responses/TooManyRequests"
          },
          "503": {
            "$ref": "#/components/responses/Unavailable"
          }
        },
        "security": [
          {
            "bearer": []
          }
        ]
      },
      "post": {
        "operationId": "start_run",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/NewRun"
              }
            }
          },
          "description": "One tenbox command to run in a box",
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Run"
                }
              }
            },
            "description": "The Job of the run is created"
          },
          "400": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "The body is not a valid run: an unknown command, class or service"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/NotMember"
          },
          "409": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "A Job of the task still runs (code machine-busy)"
          },
          "429": {
            "$ref": "#/components/responses/TooManyRequests"
          },
          "503": {
            "$ref": "#/components/responses/Unavailable"
          }
        },
        "security": [
          {
            "bearer": []
          }
        ]
      }
    },
    "/runs/{name}": {
      "delete": {
        "operationId": "stop_run",
        "parameters": [
          {
            "description": "The name of the run, the name of its Job",
            "in": "path",
            "name": "name",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "The run is stopped: its Job and pod are deleted, or were gone"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/NotMember"
          },
          "404": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Tenport does not know the run"
          },
          "429": {
            "$ref": "#/components/responses/TooManyRequests"
          },
          "503": {
            "$ref": "#/components/responses/Unavailable"
          }
        },
        "security": [
          {
            "bearer": []
          }
        ]
      },
      "get": {
        "operationId": "find_run",
        "parameters": [
          {
            "description": "The name of the run, the name of its Job",
            "in": "path",
            "name": "name",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RunState"
                }
              }
            },
            "description": "The run, with the phase of its Job"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/NotMember"
          },
          "404": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Tenport does not know the run"
          },
          "429": {
            "$ref": "#/components/responses/TooManyRequests"
          },
          "503": {
            "$ref": "#/components/responses/Unavailable"
          }
        },
        "security": [
          {
            "bearer": []
          }
        ]
      }
    },
    "/runs/{name}/log": {
      "get": {
        "operationId": "read_log",
        "parameters": [
          {
            "description": "The name of the run, the name of its Job",
            "in": "path",
            "name": "name",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "follow",
            "required": false,
            "schema": {
              "type": "boolean"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "text/plain": {
                "schema": {
                  "type": "string"
                }
              }
            },
            "description": "The log of the box container; with follow=true it stays open until the container ends"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/NotMember"
          },
          "404": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Tenport does not know the run"
          },
          "409": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "The box container has not started (code box-not-started; ask again after Retry-After seconds), or the Job is gone (code job-gone)",
            "headers": {
              "Retry-After": {
                "description": "Seconds to wait before asking again; only with box-not-started",
                "schema": {
                  "format": "int32",
                  "minimum": 0,
                  "type": "integer"
                }
              }
            }
          },
          "429": {
            "$ref": "#/components/responses/TooManyRequests"
          },
          "503": {
            "$ref": "#/components/responses/Unavailable"
          }
        },
        "security": [
          {
            "bearer": []
          }
        ]
      }
    },
    "/tasks/{task}": {
      "delete": {
        "operationId": "delete_task",
        "parameters": [
          {
            "description": "The task id, such as TEN-301",
            "in": "path",
            "name": "task",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "project",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DeletedTask"
                }
              }
            },
            "description": "The task is deleted. `archive` is `deleted`, or `missing` when the bucket had no task archive, so a second delete is safe"
          },
          "400": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Not a task id or a project id"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/NotMember"
          },
          "409": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "A Job of the task still runs (code machine-busy); nothing is deleted"
          },
          "429": {
            "$ref": "#/components/responses/TooManyRequests"
          },
          "503": {
            "$ref": "#/components/responses/Unavailable"
          }
        },
        "security": [
          {
            "bearer": []
          }
        ]
      }
    }
  }
}

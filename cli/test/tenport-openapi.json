{
  "components": {
    "schemas": {
      "Health": {
        "properties": {
          "ok": {
            "type": "boolean"
          }
        },
        "required": [
          "ok"
        ],
        "type": "object"
      },
      "Me": {
        "properties": {
          "email": {
            "type": [
              "string",
              "null"
            ]
          },
          "github": {
            "type": "string"
          },
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "organizations": {
            "items": {
              "$ref": "#/components/schemas/MyOrganization"
            },
            "type": "array"
          }
        },
        "required": [
          "id",
          "name",
          "github",
          "organizations"
        ],
        "type": "object"
      },
      "MyOrganization": {
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "role": {
            "$ref": "#/components/schemas/Role"
          }
        },
        "required": [
          "id",
          "name",
          "role"
        ],
        "type": "object"
      },
      "NewProject": {
        "properties": {
          "name": {
            "type": "string"
          },
          "org": {
            "type": "string"
          },
          "repo": {
            "example": "enojen/tenport",
            "type": "string"
          }
        },
        "required": [
          "org",
          "name",
          "repo"
        ],
        "type": "object"
      },
      "Problem": {
        "properties": {
          "code": {
            "type": "string"
          },
          "detail": {
            "type": "string"
          },
          "status": {
            "format": "int32",
            "minimum": 0,
            "type": "integer"
          },
          "title": {
            "type": "string"
          },
          "type": {
            "type": "string"
          }
        },
        "required": [
          "type",
          "title",
          "status",
          "detail",
          "code"
        ],
        "type": "object"
      },
      "Project": {
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "org": {
            "type": "string"
          },
          "repo": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "org",
          "name",
          "repo"
        ],
        "type": "object"
      },
      "Recorded": {
        "properties": {
          "skipped": {
            "minimum": 0,
            "type": "integer"
          },
          "stored": {
            "minimum": 0,
            "type": "integer"
          }
        },
        "required": [
          "stored",
          "skipped"
        ],
        "type": "object"
      },
      "ReportedEvent": {
        "allOf": [
          {
            "$ref": "#/components/schemas/TasksEvent"
          },
          {
            "properties": {
              "at": {
                "format": "date-time",
                "type": "string"
              },
              "id": {
                "example": "019a8f2e-7c4b-7d21-9a3e-5b8c1d2e3f40",
                "type": "string"
              }
            },
            "required": [
              "id",
              "at"
            ],
            "type": "object"
          }
        ]
      },
      "Role": {
        "enum": [
          "admin",
          "member"
        ],
        "type": "string"
      },
      "TaskClosed": {
        "properties": {
          "project": {
            "type": "string"
          },
          "task": {
            "example": "TEN-301",
            "type": "string"
          }
        },
        "required": [
          "project",
          "task"
        ],
        "type": "object"
      },
      "TaskStarted": {
        "properties": {
          "project": {
            "type": "string"
          },
          "task": {
            "example": "TEN-301",
            "type": "string"
          },
          "title": {
            "type": [
              "string",
              "null"
            ]
          },
          "url": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "project",
          "task"
        ],
        "type": "object"
      },
      "TasksEvent": {
        "oneOf": [
          {
            "allOf": [
              {
                "$ref": "#/components/schemas/TaskStarted"
              },
              {
                "properties": {
                  "type": {
                    "enum": [
                      "task.started"
                    ],
                    "type": "string"
                  }
                },
                "required": [
                  "type"
                ],
                "type": "object"
              }
            ]
          },
          {
            "allOf": [
              {
                "$ref": "#/components/schemas/TaskClosed"
              },
              {
                "properties": {
                  "type": {
                    "enum": [
                      "task.closed"
                    ],
                    "type": "string"
                  }
                },
                "required": [
                  "type"
                ],
                "type": "object"
              }
            ]
          }
        ]
      }
    },
    "securitySchemes": {
      "bearer": {
        "scheme": "bearer",
        "type": "http"
      }
    }
  },
  "info": {
    "description": "The backend of Tenyard",
    "license": {
      "name": "FSL-1.1-ALv2"
    },
    "title": "Tenport",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/events": {
      "post": {
        "operationId": "record_events",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "items": {
                  "$ref": "#/components/schemas/ReportedEvent"
                },
                "type": "array"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Recorded"
                }
              }
            },
            "description": "The new events are stored; an id Tenport has is skipped"
          },
          "400": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "The body is not a list of valid events"
          },
          "401": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "No token, or a token Tenport does not know"
          },
          "403": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "The user is not a member of a project's organization"
          },
          "409": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "An id came before with other content, or an event does not fit the state; nothing is stored"
          }
        },
        "security": [
          {
            "bearer": []
          }
        ]
      }
    },
    "/health": {
      "get": {
        "operationId": "health",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            },
            "description": "The database answers"
          },
          "503": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "The database does not answer"
          }
        }
      }
    },
    "/me": {
      "get": {
        "operationId": "me",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Me"
                }
              }
            },
            "description": "The user of the token and their organizations"
          },
          "401": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "No token, or a token Tenport does not know"
          }
        },
        "security": [
          {
            "bearer": []
          }
        ]
      }
    },
    "/projects": {
      "get": {
        "operationId": "list_projects",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/Project"
                  },
                  "type": "array"
                }
              }
            },
            "description": "The projects of the user's organizations"
          },
          "401": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "No token, or a token Tenport does not know"
          }
        },
        "security": [
          {
            "bearer": []
          }
        ]
      },
      "post": {
        "operationId": "add_project",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/NewProject"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Project"
                }
              }
            },
            "description": "The project is added"
          },
          "400": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "The body is not a valid new project"
          },
          "401": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "No token, or a token Tenport does not know"
          },
          "403": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "The user is not an admin of the organization"
          }
        },
        "security": [
          {
            "bearer": []
          }
        ]
      }
    }
  }
}
